{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "initialize",
        "get-kpis",
        "get-pipeline-kpis"
      ]
    },
    "initialize": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "minLength": 1
        },
        "targetUserId": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        }
      },
      "required": [
        "templateId"
      ],
      "additionalProperties": false
    },
    "getPipelineKpis": {
      "type": "object",
      "properties": {
        "targetUserId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "getKpis": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "targetUserId": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "date-time",
          "description": "Full ISO timestamp with Z or a timezone offset."
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "description": "Full ISO timestamp with Z or a timezone offset."
        }
      },
      "required": [
        "agentId",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
