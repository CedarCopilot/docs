{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update-fields",
        "create-event",
        "mutate",
        "reassign-ownership",
        "link-external-crm-deal",
        "sync-gmail-thread",
        "convert-hubspot-lead",
        "create-opportunity",
        "handoff-crm-record",
        "log-email-activity"
      ],
      "description": "Matching params only."
    },
    "create": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name."
        },
        "status": {
          "type": "string",
          "description": "Configured AOP status."
        },
        "aopId": {
          "type": "string",
          "format": "uuid",
          "description": "list-aops UUID; omit for default."
        },
        "priority": {
          "type": "string",
          "description": "Omit if inapplicable."
        },
        "nextStep": {
          "type": "string",
          "description": "Next action."
        },
        "objective": {
          "type": "string",
          "description": "Goal."
        },
        "dealValue": {
          "type": "number",
          "description": "Smallest currency unit (USD cents)."
        },
        "participantEmails": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          },
          "description": "Contacts; single=primary."
        },
        "companyDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Use lookup-company-fuzzy."
        },
        "searchEmails": {
          "type": "boolean",
          "description": "Attach history; needs companyDomain."
        },
        "companyDomain": {
          "type": "string",
          "description": "Required domain if searchEmails."
        }
      },
      "required": [
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "updateFields": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Cedar UUID; optional only in active UI."
        },
        "title": {
          "type": "string",
          "description": "Change title."
        },
        "reasoning": {
          "type": "string",
          "description": "Evidence per value; omit only for direct user requests."
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Exact field name from get-conversation."
              },
              "changeSummary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180,
                "description": "Text delta; full value separate. No invented counts/resolutions or success. Omit for scalars."
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "description": "Opt-in only: high=direct; medium=review; low=ask."
              },
              "decision": {
                "type": "string",
                "enum": [
                  "change",
                  "keep"
                ],
                "description": "Default change; keep never writes; confident keep silent."
              },
              "uncertainty": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "description": "Low/medium: missing fact."
              },
              "mode": {
                "type": "string",
                "enum": [
                  "replace",
                  "patch",
                  "upsert",
                  "append",
                  "update"
                ],
                "description": "People upsert; history append/update. Keys merge; arrays replace. replace=value; patch=old_string/new_string."
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "people": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "name": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "title": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "email": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "email"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "contactId": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "engagement": {
                                  "type": "string",
                                  "enum": [
                                    "mentioned",
                                    "introduced",
                                    "engaged",
                                    "should_engage",
                                    "critical_to_engage"
                                  ]
                                },
                                "engagementPriority": {
                                  "type": "string",
                                  "enum": [
                                    "critical",
                                    "recommended",
                                    "none"
                                  ]
                                },
                                "engagementReason": {
                                  "type": "string"
                                },
                                "roles": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  },
                                  "maxItems": 3
                                },
                                "support": {
                                  "type": "string",
                                  "enum": [
                                    "strong_support",
                                    "support",
                                    "neutral",
                                    "opposed",
                                    "unknown"
                                  ]
                                },
                                "summary": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "evidence": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "eventId": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "quote": {
                                        "type": "string",
                                        "minLength": 1
                                      }
                                    },
                                    "required": [
                                      "eventId",
                                      "quote"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "additionalProperties": false,
                              "description": "New ID: name, engagement, roles, support, summary, evidence required; existing ID: changed properties only."
                            },
                            "maxItems": 40
                          }
                        },
                        "required": [
                          "people"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "entries": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "title": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 120
                                },
                                "occurredAt": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "kind": {
                                  "type": "string",
                                  "enum": [
                                    "meeting",
                                    "correspondence",
                                    "email",
                                    "milestone"
                                  ]
                                },
                                "summary": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 600
                                },
                                "sourceEventIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "minItems": 1
                                }
                              },
                              "required": [
                                "id"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "entries"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "stage": {
                                "type": "string",
                                "enum": [
                                  "discovery",
                                  "demo",
                                  "commercial",
                                  "negotiation"
                                ]
                              },
                              "rows": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "label": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "value": {
                                      "type": "string"
                                    },
                                    "graded": {
                                      "type": "boolean",
                                      "default": true
                                    },
                                    "signal": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "enum": [
                                            "green",
                                            "yellow",
                                            "red"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "default": null
                                    },
                                    "signalReasoning": {
                                      "type": [
                                        "string",
                                        "null"
                                      ]
                                    },
                                    "strength": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 100
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "label",
                                    "value"
                                  ],
                                  "additionalProperties": false
                                },
                                "maxItems": 3
                              },
                              "rubric": {
                                "type": "string"
                              },
                              "checklist": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "label": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "completed": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "id",
                                    "label",
                                    "completed"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "stage"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "rows": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/properties/updateFields/properties/fields/items/properties/value/anyOf/4/anyOf/2/anyOf/0/properties/rows/items"
                                }
                              }
                            },
                            "required": [
                              "rows"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    ]
                  }
                ],
                "description": "Scalar/object/JSON; preserve IDs. Omit for patches."
              },
              "old_string": {
                "type": "string",
                "description": "Unique current-value substring from get-conversation."
              },
              "new_string": {
                "type": "string",
                "description": "Patch text; \"\" deletes old_string."
              },
              "signal": {
                "type": "string",
                "enum": [
                  "red",
                  "yellow",
                  "green"
                ],
                "description": "Only if instructed; follow field red/yellow/green rubric."
              },
              "signalReasoning": {
                "type": "string",
                "description": "Brief explanation for the signal."
              },
              "reasoning": {
                "type": "string",
                "description": "Evidence: source/person/date; no Why/field/confidence prefix. Gaps in uncertainty. No raw IDs. Use plain language and descriptive verified links; never invent URLs."
              },
              "strength": {
                "type": "number",
                "description": "Owned type:list scorecard only: 1–100; value=verbatim evidence, reasoning=justification, together on one event atom, never persistent fields."
              },
              "contextQuote": {
                "type": "string",
                "description": "Scorecard triple only: verbatim lead-in; omit for bare quotes."
              },
              "reactionQuote": {
                "type": "string",
                "description": "Scorecard triple with contextQuote: verbatim reaction; omit if absent."
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "description": "get writable fields only; relay blockedReason; empty needs linkCrmDeal."
        },
        "targetDealId": {
          "type": "string",
          "description": "Deal ID if multiple."
        },
        "linkCrmDeal": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "description": "The CRM provider identifier (e.g. \"hubspot\", \"salesforce\", \"attio\")"
            },
            "dealId": {
              "type": "string",
              "description": "The opportunity/deal ID returned by the CRM after creation"
            },
            "instanceUrl": {
              "type": "string",
              "description": "For Salesforce: the org Lightning base URL. For HubSpot: the portal hub_id (e.g. \"245934213\") — required to generate deep-link URLs."
            }
          },
          "required": [
            "provider",
            "dealId"
          ],
          "additionalProperties": false,
          "description": "Link dealId before sync; new: create-opportunity."
        }
      },
      "additionalProperties": false
    },
    "createEvent": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Cedar UUID."
        },
        "eventType": {
          "type": "string",
          "enum": [
            "meeting",
            "call",
            "text",
            "custom"
          ],
          "description": "Meeting, call, chat or custom."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short event title."
        },
        "occurredAt": {
          "type": "string",
          "description": "ISO datetime; default now."
        },
        "externalEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Stable source occurrence ID for call/text. Reuse the same ID and occurrence timestamp on retries."
        },
        "triggerPlaybook": {
          "type": "boolean",
          "description": "Call/text only. Opt in to matching deal playbook triggers on first creation. Requires externalEventId."
        },
        "description": {
          "type": "string",
          "description": "Event summary."
        },
        "notes": {
          "type": "string",
          "description": "Personal meeting/call.notes."
        },
        "transcript": {
          "type": "string",
          "description": "Verbatim; use requirePaste."
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "email": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "email",
              "name"
            ],
            "additionalProperties": false
          },
          "description": "Meeting/call attendees."
        },
        "content": {
          "type": "string",
          "description": "Body for eventType:text only."
        },
        "requirePaste": {
          "type": "boolean",
          "description": "True for transcripts; omit transcript."
        }
      },
      "required": [
        "conversationId",
        "eventType",
        "title",
        "occurredAt"
      ],
      "additionalProperties": false
    },
    "mutate": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Approval card: one plain sentence; no IDs/jargon."
        },
        "mutation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "move_event"
                },
                "eventId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "ID of any event in the thread to move"
                },
                "targetConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Existing destination; exclusive with newConversation."
                },
                "newConversation": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "New name; defaults to company domain, else \"New deal\"."
                    },
                    "companyDomain": {
                      "type": "string",
                      "description": "Real counterparty domain from event evidence, not a misrouted sender's domain. Omit if unsure; no primary company is set."
                    },
                    "aopId": {
                      "type": "string",
                      "description": "New deal AOP; omit for automatic selection from event."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Create destination and move event; exclusive with targetConversationId."
                }
              },
              "required": [
                "operation",
                "eventId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "reassign_aop"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "aopId": {
                  "type": "string",
                  "description": "ID of the AOP to assign"
                }
              },
              "required": [
                "operation",
                "conversationId",
                "aopId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "refresh_conversation"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "reconcile",
                    "full"
                  ],
                  "default": "reconcile",
                  "description": "reconcile: fields+tasks, no draft (default). full: rerun one event including drafting; requires eventId."
                },
                "eventId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Required for scope:'full' — the event whose on-event pipeline to re-run."
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "refresh_fields"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "clear_working_memory"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "merge_conversations"
                },
                "sourceConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Source: move events/tasks/history to target, then delete."
                },
                "targetConversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Surviving target conversation."
                }
              },
              "required": [
                "operation",
                "sourceConversationId",
                "targetConversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "merge_companies"
                },
                "sourceCompanyId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Source company: permanently alias to target."
                },
                "targetCompanyId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Surviving canonical company."
                }
              },
              "required": [
                "operation",
                "sourceCompanyId",
                "targetCompanyId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "fix_misassignment"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "dryRun": {
                  "type": "boolean",
                  "default": true,
                  "description": "Preview only when true."
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "assign_aop_by_selection"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Repick AOP from this conversation’s email history."
                }
              },
              "required": [
                "operation",
                "conversationId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "string",
                  "const": "rename_conversation"
                },
                "conversationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "description": "New display name for the conversation"
                }
              },
              "required": [
                "operation",
                "conversationId",
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "conversationId": {
          "type": "string",
          "description": "Primary conversation ID for approval card."
        }
      },
      "required": [
        "description",
        "mutation"
      ],
      "additionalProperties": false
    },
    "reassignOwnership": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Cedar UUID."
        },
        "newOwnerUserId": {
          "type": "string",
          "description": "New owner’s Cedar org member ID."
        }
      },
      "required": [
        "conversationId",
        "newOwnerUserId"
      ],
      "additionalProperties": false
    },
    "linkExternalCrmDeal": {
      "type": "object",
      "properties": {
        "conversationId": {
          "$ref": "#/properties/reassignOwnership/properties/conversationId"
        },
        "providerId": {
          "type": "string",
          "enum": [
            "hubspot",
            "attio",
            "salesforce",
            "copper"
          ]
        },
        "dealId": {
          "type": "string",
          "minLength": 1,
          "description": "External deal ID from search-external-crm-deals."
        }
      },
      "required": [
        "conversationId",
        "providerId",
        "dealId"
      ],
      "additionalProperties": false,
      "description": "External CRM; clarify ambiguity."
    },
    "syncGmailThread": {
      "type": "object",
      "properties": {
        "conversationId": {
          "$ref": "#/properties/reassignOwnership/properties/conversationId"
        },
        "threadId": {
          "type": "string",
          "description": "Gmail ID or searchQuery."
        },
        "searchQuery": {
          "type": "string",
          "description": "Alternative to threadId; disambiguate."
        }
      },
      "required": [
        "conversationId"
      ],
      "additionalProperties": false,
      "description": "Check find-event first; imports live Gmail, processes drafts."
    },
    "convertHubspotLead": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Source Lead conversation UUID; native ID is server-resolved."
        },
        "targetDealAopId": {
          "type": "string",
          "format": "uuid",
          "description": "Source owner's active Deals playbook UUID."
        },
        "dealName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "dealPipelineId": {
          "type": "string",
          "minLength": 1,
          "description": "Configured Deal pipeline ID; never choose a default."
        },
        "dealStageId": {
          "type": "string",
          "minLength": 1,
          "description": "Configured open Deal stage ID."
        },
        "qualifiedStageId": {
          "type": "string",
          "minLength": 1,
          "description": "Qualified stage ID in the source Lead pipeline."
        }
      },
      "required": [
        "conversationId",
        "targetDealAopId",
        "dealName",
        "dealPipelineId",
        "dealStageId",
        "qualifiedStageId"
      ],
      "additionalProperties": false
    },
    "createOpportunity": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "hubspot",
            "salesforce",
            "attio"
          ]
        },
        "intentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "default": "new-business",
          "description": "First sale: new-business. Renewal/upsell: explicit distinct cycle/product. Never company alias, event ID or run ID."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "instructions": {
          "type": "string",
          "maxLength": 100000
        },
        "proposedFields": {
          "type": "object",
          "additionalProperties": {},
          "default": {}
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          },
          "description": "fromType,toType,toId; optional fromId ($opportunity), sourced name,label,Attio field."
        },
        "approvalMode": {
          "type": "string",
          "enum": [
            "required",
            "automatic"
          ],
          "default": "required"
        },
        "notifySettings": {
          "type": "object",
          "additionalProperties": {},
          "description": "notify:boolean, slackChannelId, threadTs, message, receiptMessage; dealContext:{pricingTerms,counterparty,evidence,nextStep,baaOwner,stageEvidence,closeDateBasis:estimated/agreed}."
        },
        "savedTask": {
          "type": "object",
          "properties": {
            "taskId": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "taskId",
            "revision"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "conversationId",
        "provider",
        "summary"
      ],
      "additionalProperties": false
    },
    "handoffCrmRecord": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Source CRM-bound conversation UUID."
        },
        "targetAopId": {
          "type": "string",
          "format": "uuid",
          "description": "Source owner's active destination playbook UUID."
        },
        "targetRecordId": {
          "type": "string",
          "minLength": 1,
          "description": "Existing target record ID; source resolves provider/account, target playbook resolves object."
        }
      },
      "required": [
        "conversationId",
        "targetAopId",
        "targetRecordId"
      ],
      "additionalProperties": false
    },
    "logEmailActivity": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "description": "Exact message in the selected mailbox thread."
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "type": "string",
          "const": "hubspot",
          "description": "CRM providers with an email activity writer."
        },
        "dealId": {
          "type": "string",
          "pattern": "^[1-9]\\d{0,24}$",
          "description": "Existing linked external deal ID."
        }
      },
      "required": [
        "threadId",
        "messageId",
        "conversationId",
        "provider",
        "dealId"
      ],
      "additionalProperties": false
    },
    "user_request_summary": {
      "type": "string",
      "description": "One sentence, in your own words: what the user actually asked you to do in this turn. Used only for Cedar's observability — it does not change what this tool does."
    },
    "is_new_request": {
      "type": "boolean",
      "description": "true on the FIRST Cedar tool call of a NEW user request; false when this call continues the same request you are already working on. Groups related calls into one activity thread."
    }
  },
  "required": [
    "action",
    "user_request_summary",
    "is_new_request"
  ],
  "additionalProperties": true,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
