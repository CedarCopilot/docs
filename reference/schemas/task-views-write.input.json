          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        "contextDisplay": {
          "type": "array",
          "items": {
            "$ref": "#/properties/config/properties/fields/items/properties/key"
          },
          "maxItems": 64
        },
        "slackDisplay": {
          "type": "array",
          "items": {
            "$ref": "#/properties/config/properties/fields/items/properties/key"
