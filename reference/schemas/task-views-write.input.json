{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "create",
        "initialize",
        "invoke-action",
        "restore-history",
        "configure",
        "saved-policy",
        "archive",
        "restore",
        "associate",
        "patch-values",
        "upsert-context",
        "manual",
        "organize",
        "place"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "maxLength": 30000
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,79}$"
              },
              "label": {
                "$ref": "#/properties/config/properties/title"
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "long_text",
                  "number",
                  "score",
                  "currency",
                  "percent",
                  "date",
                  "checkbox",
                  "select",
                  "multi_select",
                  "url",
                  "email",
                  "doc",
                  "conversation",
                  "person",
                  "company"
                ]
              },
              "instructions": {
                "$ref": "#/properties/config/properties/purpose"
              },
              "options": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/config/properties/title"
                },
                "maxItems": 100
              },
              "required": {
                "type": "boolean",
                "default": false
              },
              "rubric": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "number"
                    },
                    "description": {
                      "$ref": "#/properties/config/properties/title"
                    }
                  },
                  "required": [
                    "value",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2,
                "maxItems": 10
              },
              "source": {
                "type": "string",
                "enum": [
                  "task.description",
                  "task.status",
                  "task.dueDate",
                  "task.createdBy",
                  "task.output",
                  "conversation.title",
                  "conversation.nextMeeting",
                  "conversation.field",
                  "event.field",
                  "jev"
                ]
              },
              "sourceField": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-zA-Z0-9_.-]+$"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          "maxItems": 64
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/properties/config/properties/fields/items/properties/key"
              },
              "label": {
                "$ref": "#/properties/config/properties/title"
              },
              "instructions": {
                "$ref": "#/properties/config/properties/purpose"
              },
              "display": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/config/properties/fields/items/properties/key"
                },
                "maxItems": 64
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "rowDisplay": {
          "type": "array",
          "items": {
            "$ref": "#/properties/config/properties/fields/items/properties/key"
          },
          "maxItems": 64
        },
        "briefDisplay": {
          "type": "array",
          "items": {
            "$ref": "#/properties/config/properties/fields/items/properties/key"
