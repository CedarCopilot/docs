                "gmailLabels": {
                  "type": "boolean",
                  "default": false
                }
              },
              "required": [
                "mode",
                "slackChannelId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
