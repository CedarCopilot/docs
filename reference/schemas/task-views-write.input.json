                    "type": "string",
                    "enum": [
                      "recap",
                      "inbound-response",
                      "crm-proposal",
                      "custom"
                    ]
                  },
                  "maxItems": 4
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "live"
                },
                "monitoringDestination": {
                  "$ref": "#/properties/config/properties/delivery/anyOf/0/properties/monitoringDestination"
