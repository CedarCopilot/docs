{
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "prepareDelivery",
        "reviewDelivery",
        "applyApproval",
        "create",
        "batch",
        "update",
        "cancel",
        "assignmentOptions",
        "reassign",
        "dealList",
        "creationOptions",
        "createAssigned",
        "complete",
        "delete",
        "start",
        "updateDueDate",
        "snooze",
        "unsnooze",
        "attach-document"
      ],
      "description": "Pass matching action-named params."
    },
    "list": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid",
          "description": "One permitted task with a bounded notes page."
        },
        "notesOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147482623,
          "description": "Requires taskId. Notes character offset; start at 0, follow nextNotesOffset for omitted details."
        },
        "scope": {
          "type": "string",
          "enum": [
            "#today",
            "#overdue",
            "#crm-approvals",
            "#all"
          ],
          "description": "#all: all open work user-wide; ignores conversation/dates, includes recommendations by default. Follow nextCursor. Deal inventory: omit scope, set conversationId. #crm-approvals: user-wide open CRM approvals. #today: previous 7 days through today. #overdue: all before today. Date scopes use conversationId when supplied, else user-wide."
        },
        "cursor": {
          "type": "string",
          "description": "Opaque nextCursor from the previous page; keep all other filters unchanged."
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetUserId": {
          "type": "string",
          "description": "Org owner/admin only: list another same-org member's tasks by passing their userId (e.g. an org-level triage agent surfacing a rep's overdue work). Omit to list your own. Rejected for non-admins and for a target outside your org."
        },
        "activeAopNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User-wide only (#all or date scope without conversationId). Filter conversation AOPs; pass canvas selectedAopNames. Excludes no-op AOPs (Spam, Vendor notification, etc.)."
        },
        "excludeStatuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User-wide only. Exclude conversation statuses; get closed/terminal values from AOP config, never hardcode."
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Filter lane names case-insensitively. Names are user-editable: read the task-group list; never assume defaults."
        },
        "outputKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "email",
              "slack",
              "calendar",
              "linkedin",
              "whatsapp",
              "crm-field",
              "crm-opportunity",
              "file",
              "sequence",
              "recommendation",
              "none"
            ]
          },
          "description": "Filter by what finishing the task PRODUCES. Use this for artifact questions, not lane questions: [\"crm-field\", \"crm-opportunity\"] for CRM approvals awaiting the user, [\"email\", \"slack\"] for drafts to review, [\"none\"] for pure reminders. Combined with `groups` as AND (a task must be in one of the groups AND produce one of the kinds)."
        },
        "includeDraftContent": {
          "type": "boolean",
          "description": "Default true. False returns metadata without provider reads; draft existence unverified."
        },
        "includeProposalRevisions": {
          "type": "boolean",
          "description": "Opt in to current owner-only manual proposal revision hashes for configuring per-task resource creation actions. Does not execute or approve anything."
        },
        "includeRecommended": {
          "type": "boolean",
          "description": "Include recommendations alongside accepted work. Defaults on for a deal inventory or #all, off for date/CRM-approval scopes; explicit false lists accepted work only. Recommendations are labeled separately."
        },
        "conversationId": {
          "type": "string",
          "description": "Deal ID; required without scope. Omit for user-wide date queries."
        }
      },
      "additionalProperties": false
    },
    "prepareDelivery": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "plan": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cadence"
            },
            "sequenceId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedSequenceVersion": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "templateSequenceId": {
              "type": "string",
              "format": "uuid"
            },
            "contactId": {
              "type": "string",
              "format": "uuid",
              "description": "Organization account contact ID, or a participant ID from this task conversation that resolves uniquely to an account contact."
            },
            "startAt": {
              "type": "string",
              "format": "date-time"
            },
            "calendarEventId": {
              "type": "string",
              "format": "uuid"
            },
            "calendarConnectionId": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stepId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channel": {
                    "type": "string",
                    "enum": [
                      "email",
                      "linkedin",
                      "linkedin_connect",
                      "linkedin_inmail",
                      "slack_dm"
                    ]
                  },
                  "automationMode": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "manual"
                    ]
                  },
                  "sendAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "delayHours": {
                    "type": "number",
                    "minimum": 0
                  },
                  "slack": {
                    "type": "object",
                    "properties": {
                      "containerId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "threadTs": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+$"
                      }
                    },
                    "required": [
                      "containerId"
                    ],
                    "additionalProperties": false
                  },
                  "recipients": {
                    "type": "object",
                    "properties": {
                      "to": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "format": "email"
                        },
                        "minItems": 1
                      },
                      "cc": {
                        "type": "array",
                        "items": {
                          "$ref": "#/properties/prepareDelivery/properties/plan/properties/steps/items/properties/recipients/properties/to/items"
                        },
                        "default": []
                      },
                      "bcc": {
                        "type": "array",
                        "items": {
                          "$ref": "#/properties/prepareDelivery/properties/plan/properties/steps/items/properties/recipients/properties/to/items"
                        },
                        "default": []
                      }
                    },
                    "required": [
                      "to"
                    ],
                    "additionalProperties": false,
                    "description": "Exact actual To/Cc/Bcc recipients for this email step. Omit to use the existing contact default."
                  },
                  "draft": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string"
                      },
                      "body": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "body"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "stepId",
                  "channel",
                  "automationMode",
                  "draft"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 12
            }
          },
          "required": [
            "kind",
            "contactId",
            "steps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "taskId",
        "plan"
      ],
      "additionalProperties": false
    },
    "reviewDelivery": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "attach-document": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "documentId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedTaskRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expectedAssignmentVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "taskId",
        "documentId",
        "expectedTaskRevision",
        "expectedAssignmentVersion"
      ],
      "additionalProperties": false
    },
    "applyApproval": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "create": {
      "type": "object",
      "properties": {
        "assigneeUserId": {
          "type": "string",
          "minLength": 1,
          "description": "Eligible org assignee; defaults to caller."
        },
        "conversationId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Conversation; omission requires taskViews."
        },
        "taskViews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "taskViewId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedSchemaRevision": {
                "type": "integer",
                "minimum": 0
              },
              "expectedVersion": {
                "type": "integer",
                "minimum": 0,
                "default": 0,
                "description": "Use 0 only for a new association. To change existing values, read the current association and pass its returned version."
              },
              "values": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "taskViewId",
              "expectedSchemaRevision",
              "values"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Plain headline — detail. Omit deal name, markdown and line breaks."
        },
        "creationReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Why created; never guess."
        },
        "instructionReferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "maxItems": 5,
          "description": "Real instruction/evidence refs; omit unknown."
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Execution instructions only. Null clears."
        },
        "taskChannel": {
          "type": "string",
          "enum": [
            "email",
            "slack",
            "linkedin",
            "whatsapp"
          ],
          "description": "Commitment channel only. Omit for open-ended work; decide at execution."
        },
        "taskType": {
          "type": "string",
          "enum": [
            "response",
            "follow-up",
            "post-meeting",
            "pre-meeting",
            "reactivation",
            "manual",
            "calendar",
            "crm-opportunity",
            "field-approval"
          ],
          "description": "Output type; response=inbound, follow-up=outbound, manual=general. Load tasks for CRM notes requirements."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "promised",
              "awaiting-them"
            ]
          },
          "description": "One: promised=user owes; awaiting-them=other owes. Omit unknown."
        },
        "dueDate": {
          "type": "string",
          "description": "ISO timestamp or NOW. Manual: NOW unless blocked until a future response, dependency or calendar date; deadlines go in notes. Agent: future ISO timestamp (09:00 UTC for morning drafts)."
        },
        "agentExecutionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Prepare drafts; keep todo until fulfilled."
        },
        "threadId": {
          "type": "string",
          "description": "Email thread ID; required for response tasks."
        }
      },
      "required": [
        "description",
        "dueDate"
      ],
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "properties": {
        "taskViewId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedSchemaRevision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "reference"
                ]
              },
              "actionKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 50000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dueDate": {
                "type": "string",
                "format": "date-time"
              },
              "assigneeId": {
                "$ref": "#/properties/batch/properties/items/items/properties/actionKey"
              },
              "conversationId": {
                "type": "string",
                "format": "uuid"
              },
              "taskId": {
                "type": "string",
                "format": "uuid"
              },
              "expectedUpdatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "expectedAssignmentVersion": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "action",
              "actionKey"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "taskViewId",
        "expectedSchemaRevision",
        "title",
        "summary",
        "items"
      ],
      "additionalProperties": false
    },
    "update": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Audit reason for a due-date change. Supply alongside dueDate. Keep task notes for execution instructions."
        },
        "completionEvidence": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "format": "uuid",
              "description": "CRM event UUID; OR use both source IDs."
            },
            "sourceThreadId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Sent source thread ID, not task draft ID."
            },
            "sourceMessageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Sent source message ID, not task draft ID."
            },
            "taskDescription": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            },
            "draftId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "TASK linked draft ID from inventory; never source message ID."
            },
            "quote": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            },
            "reason": {
              "type": "string",
              "minLength": 20,
              "maxLength": 4000
            }
          },
          "required": [
            "taskDescription",
            "draftId",
            "quote",
            "reason"
          ],
          "additionalProperties": false,
          "description": "Fulfillment proof: eventId OR sourceThreadId+sourceMessageId; never both."
        },
        "taskViews": {
          "$ref": "#/properties/create/properties/taskViews"
        },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "description": "Task ID"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Plain headline — detail. Omit deal name, markdown and line breaks."
        },
        "revisionReason": {
          "$ref": "#/properties/create/properties/creationReason",
          "description": "Why revised; original reason stays."
        },
        "instructionReferences": {
          "$ref": "#/properties/create/properties/instructionReferences",
          "description": "Real instruction/evidence refs; omit unknown."
        },
        "notes": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Execution instructions only. Null clears."
        },
        "taskType": {
          "anyOf": [
            {
              "$ref": "#/properties/create/properties/taskType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Output type; response=inbound, follow-up=outbound, manual=general. Load tasks for CRM notes requirements."
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/properties/create/properties/tags/items"
          },
          "description": "One: promised=user owes; awaiting-them=other owes. Omit unknown."
        },
        "dueDate": {
          "type": "string",
          "description": "For scheduling tasks with status \"todo\": ISO 8601 timestamp (e.g., \"2024-01-15T14:30:00Z\") Or NOW for immediate user action, with agent execution disabled."
        },
        "agentExecutionEnabled": {
          "type": "boolean",
          "description": "Prepare drafts; keep todo until fulfilled."
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "done"
          ],
          "description": "todo: still owed. done: fulfilled. Use cancel-task for obsolete work."
        },
        "cleanupDraft": {
          "type": "boolean",
          "description": "Clean stale draft and label only after equivalent delivery (done)."
        },
        "taskGroupId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Lane UUID from config read-settings task_groups. Null=Misc; omit=unchanged."
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "cancel": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Explicit cancellation targets."
        },
        "cancelOlderThan": {
          "type": "string",
          "description": "Cancel tasks due before this ISO date. Overrides taskIds."
        },
        "taskCreatedBy": {
          "type": "string",
          "enum": [
            "agent",
            "user"
          ],
          "description": "Age filter by creator. Defaults to agent."
        },
        "bulkConversationId": {
          "type": "string",
          "format": "uuid",
          "description": "Limit age cleanup to this deal."
        },
        "conversationStatuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Deal statuses, optionally combined with age."
        },
        "conversationAopNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AOP names, combinable with age and status."
        }
      },
      "additionalProperties": false
    },
    "assignmentOptions": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false
    },
    "reassign": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/properties/assignmentOptions/properties/taskId"
        },
        "assignmentNote": {
          "type": "string",
          "maxLength": 4000,
          "description": "Optional instructions from the assigning person; retained with assignment history."
        },
        "assigneeUserId": {
          "type": "string",
          "minLength": 1,
          "description": "Use a userId returned by assignmentOptions; never guess."
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0,
          "description": "Use assignmentVersion from assignmentOptions; for recovery use pendingTransfer.expectedVersion."
        },
        "idempotencyKey": {
          "type": "string",
          "format": "uuid",
          "description": "A new UUID per transfer. Preserve it for retries; for pending recovery reuse pendingTransfer.idempotencyKey."
        },
        "acknowledgeDraftDeletion": {
          "type": "boolean",
          "description": "True when the user or approved operating instructions authorize discarding the existing draft during reassignment. Reuse authorization from earlier turns; do not ask again. Otherwise false and ask only if requiresDraftDeletion."
        }
      },
      "required": [
        "taskId",
        "assigneeUserId",
        "expectedVersion",
        "idempotencyKey",
        "acknowledgeDraftDeletion"
      ],
      "additionalProperties": false
    },
    "dealList": {
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "format": "uuid"
        },
        "filter": {
          "type": "string",
          "enum": [
            "all",
            "assignedToMe",
            "dealTasks",
            "recommendations"
          ]
        }
      },
      "additionalProperties": false
    },
    "creationOptions": {
      "type": "object",
      "properties": {
        "conversationId": {
          "$ref": "#/properties/dealList/properties/conversationId"
        }
      },
      "additionalProperties": false
    },
    "createAssigned": {
      "type": "object",
      "properties": {
        "conversationId": {
          "$ref": "#/properties/dealList/properties/conversationId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "notes": {
          "type": "string",
          "maxLength": 10000
        },
        "assigneeUserId": {
          "type": "string",
          "minLength": 1,
          "description": "Choose from creationOptions; never guess or impersonate this person."
        },
        "assignmentNote": {
          "type": "string",
          "maxLength": 4000
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            }
          ],
          "description": "Date-only values remind at 9 AM in the actual owner timezone; explicit ISO times are preserved."
        }
      },
      "additionalProperties": false
    },
    "complete": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "delete": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/properties/complete/properties/taskId"
        },
        "confirmDraftDeletion": {
          "type": "boolean",
          "description": "True only with user or approved standing authorization to discard the existing draft; otherwise omit and report the confirmation requirement."
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/properties/complete/properties/taskId"
        },
        "intent": {
          "type": "string",
          "enum": [
            "prepare",
            "research",
            "revise"
          ]
        },
        "launchingTaskViewId": {
          "type": "string",
          "format": "uuid"
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "snooze": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/properties/complete/properties/taskId"
        },
        "dueDate": {
