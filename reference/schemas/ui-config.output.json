{
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean"
    },
    "errorMessage": {
      "type": "string"
    },
    "canvases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "viewConfig": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ],
            "description": "Native saved configuration for owned canvases; preserve these settings when using update-canvas. Null for shared canvases."
          },
          "pinnedToHomeView": {
            "type": "boolean",
            "const": true,
            "description": "Every returned canvas is already pinned to HomeView."
          },
          "homeViewOrder": {
            "type": [
              "number",
              "null"
            ],
            "description": "Effective tab position; null does not mean unpinned."
          },
          "query": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "selectedAopNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "AOP names (e.g. [\"Deals\"]) — pass directly to find-crm-conversations selectedAopNames"
                  },
                  "columnFilters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "columnId": {
                          "type": "string"
                        },
                        "selected": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "excluded": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "searchText": {
                          "type": "string"
                        },
                        "numberValue": {
                          "type": "string",
                          "description": "Numeric value for dealValue filters"
                        },
                        "numberOperator": {
                          "type": "string",
                          "enum": [
                            "gt",
                            "lt",
                            "eq",
                            "empty"
                          ]
                        },
                        "dateFrom": {
                          "type": "string",
                          "description": "Resolved absolute ISO date string"
                        },
                        "dateTo": {
                          "type": "string",
                          "description": "Resolved absolute ISO date string (for range operator)"
                        },
                        "dateOperator": {
                          "type": "string",
                          "enum": [
                            "before",
                            "after",
                            "on",
                            "range",
                            "empty"
                          ]
                        },
                        "binaryChoice": {
                          "type": "string",
                          "enum": [
                            "true",
                            "false"
                          ]
                        }
                      },
                      "required": [
                        "columnId"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Column filters — pass directly to find-crm-conversations columnFilters"
                  },
                  "sorts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "columnId": {
                          "type": "string"
                        },
                        "active": {
                          "type": "boolean"
                        },
                        "direction": {
                          "type": "string",
                          "enum": [
                            "asc",
                            "desc"
                          ]
                        },
                        "priority": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "columnId",
                        "active",
                        "direction",
                        "priority"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Sort config — pass directly to find-crm-conversations sorts"
                  },
                  "searchQuery": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Global text search — pass to find-crm-conversations searchQuery"
                  },
                  "ownerUserIds": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "all_org"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Owner scope: null = current user only, \"all_org\" = whole org, [id,...] = specific teammates. NOTE: find-crm-conversations does not yet support this — if non-null, mention it to the user."
                  },
                  "pinnedConversationIds": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "When non-null, the canvas shows only these specific conversations regardless of filters. Pass as flexible_query filters: { field: \"id\", operator: \"in\", value: [...] }."
                  }
                },
                "required": [
                  "selectedAopNames",
                  "columnFilters",
                  "sorts",
                  "searchQuery",
                  "ownerUserIds",
                  "pinnedConversationIds"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "null for non-conversation canvases (reports, tasks, agenda, calendar)"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "viewConfig",
          "pinnedToHomeView",
          "homeViewOrder",
          "query"
        ],
        "additionalProperties": false
      }
    },
    "itemCount": {
      "type": "number"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "field",
              "doc",
              "contacts"
            ]
          },
          "fieldId": {
            "type": "string"
          },
          "fieldType": {
            "type": "string",
            "enum": [
              "cedar",
              "custom"
            ]
          },
          "docPath": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "render": {
            "type": "string",
            "enum": [
              "scalar",
              "markdown"
            ]
          },
          "displayOrder": {
            "type": "number"
          },
          "ownerAgentId": {
            "type": "string"
          },
          "visibleWhen": {},
          "addedBy": {
            "type": "string",
            "enum": [
              "seed",
              "agent",
              "user"
            ]
          },
          "hidden": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "kind",
          "displayOrder"
        ],
        "additionalProperties": false
      }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "homeViewOrder": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "homeViewOrder"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "success"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
